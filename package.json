{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate-data.mjs",
    "build:pdf": "node scripts/build-resume-pdf.mjs",
    "build:cv": "node scripts/build-resume-pdf.mjs",
    "build:og": "node scripts/build-og.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "lenis": "^1.1.14",
    "motion": "^11.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource/carlito": "^5.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "puppeteer": "^23.9.0",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  },
  "description": "JSON-driven portfolio and CV generator with an in-browser editor"
}
