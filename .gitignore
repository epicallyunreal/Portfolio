# Copies of the two site PDFs, for the dev server. The committed ones live in
# documents/, and `npm run build:pdf` writes these from them.
public/*_CV.pdf
public/*_Resume.pdf

# `build:cv` with flags writes here, and wipes it on every run.
GenerateCV/

# Original camera photos: carry EXIF (device, timestamp, GPS).
# Kept out of public/ so they are never published, and out of git so they are
# never committed to a public repo. Run scripts/optimize-headshot.mjs on them.
assets-src/

# Local tool permissions — machine-specific, not useful to anyone else.
.claude/settings.local.json
