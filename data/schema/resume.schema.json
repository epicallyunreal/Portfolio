{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resume.schema.json",
  "title": "Resume (JSON Resume subset + x_ extensions)",
  "type": "object",
  "required": ["basics", "work", "certificates", "skills", "projects", "x_meta"],
  "additionalProperties": true,
  "properties": {
    "basics": {
      "type": "object",
      "required": ["name", "label", "email", "url", "summary", "profiles"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "maxLength": 0,
          "description": "Must stay empty — the phone number is never published."
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            },
            "countryCode": {
              "type": "string"
            }
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["network", "username", "url"],
            "properties": {
              "network": {
                "type": "string",
                "minLength": 1
              },
              "username": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    "work": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "position", "startDate", "highlights"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "string",
            "minLength": 1
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"
          },
          "endDate": {
            "type": ["string", "null"],
            "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$",
            "description": "null renders as Present"
          },
          "summary": {
            "type": "string"
          },
          "highlights": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "x_tech": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "x_cv": {
            "type": "boolean",
            "description": "Omit or true: appears on the site and in the CV PDF. false: site only — the CV never sees it."
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["institution", "area", "studyType"],
        "properties": {
          "institution": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "studyType": {
            "type": "string",
            "minLength": 1
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          },
          "score": {
            "type": "string"
          },
          "x_cv": {
            "type": "boolean",
            "description": "Omit or true: appears on the site and in the CV PDF. false: site only — the CV never sees it."
          }
        }
      }
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "issuer", "date"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "minLength": 4
          },
          "url": {
            "type": "string"
          },
          "x_status": {
            "type": "string",
            "enum": ["in-progress", "completed"]
          },
          "x_statusNote": {
            "type": "string",
            "description": "Overrides the computed status parenthetical in the CV, e.g. 'capstone complete; certification in progress'."
          },
          "x_note": {
            "type": "string",
            "description": "Free-text tail appended after the tech labels in the CV line."
          },
          "x_tech": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "x_cv": {
            "type": "boolean",
            "description": "Omit or true: appears on the site and in the CV PDF. false: site only — the CV never sees it."
          }
        }
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "awarder", "date"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "awarder": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "minLength": 4
          },
          "summary": {
            "type": "string"
          },
          "x_cv": {
            "type": "boolean",
            "description": "Omit or true: appears on the site and in the CV PDF. false: site only — the CV never sees it."
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "keywords"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "x_note": {
            "type": "string",
            "description": "Free-text suffix for the group's CV line, e.g. 'spec-driven, agentic build workflows'."
          },
          "x_cv": {
            "type": "boolean",
            "description": "Omit or true: appears on the site and in the CV PDF. false: site only — the CV never sees it."
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2})?$"
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2})?$",
            "description": "Projects sort newest-first on these. Undated entries sort last."
          },
          "url": {
            "type": "string",
            "description": "Source repository. Empty when the code is not public."
          },
          "x_live": {
            "type": "string",
            "description": "Deployed, running instance. Empty when the project is not hosted anywhere."
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "x_tech": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "x_featured": {
            "type": "boolean"
          },
          "x_cv": {
            "type": "boolean",
            "description": "Omit or true: appears on the site and in the CV PDF. false: site only — the CV never sees it."
          }
        }
      }
    },
    "languages": {
      "type": "array"
    },
    "interests": {
      "type": "array"
    },
    "references": {
      "type": "array"
    },
    "x_meta": {
      "type": "object",
      "required": ["version", "headlines", "cvHeadline", "availability", "sectionOrder"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semver for the resume content itself — bump on every content change so the shared CV is traceable to a revision. Rendered in the site footer and the PDF footer."
        },
        "headlines": {
          "type": "array",
          "minItems": 1,
          "description": "Hero taglines, typed one at a time on a loop. A single entry types once and stays. The first entry is also the site's og:description.",
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "emphasis": {
                "type": "string",
                "minLength": 1,
                "description": "Substring of text to lift visually as it is typed. Must appear verbatim in text."
              }
            }
          }
        },
        "cvHeadline": {
          "type": "string",
          "minLength": 1,
          "description": "Headline for the CV header — longer than basics.label, which stays for the website."
        },
        "cvCertsInline": {
          "type": "boolean",
          "description": "true: the CV prints certifications as one comma-separated line, each name linked, with the issuer in brackets — for a variant that must fit a single page. Omitted or false: one bullet per certification."
        },
        "techLabels": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "description": "Tech key → shorter label, applied only when this document is printed as a PDF. Lets the one-page resume.json say \"DRF\" where the site and assets.json say \"Django REST Framework\"."
        },
        "availability": {
          "type": "string"
        },
        "careerStart": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2})?$"
        },
        "sectionOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "about",
              "experience",
              "skills",
              "projects",
              "certifications",
              "awards",
              "lab",
              "contact"
            ]
          }
        }
      }
    }
  }
}
